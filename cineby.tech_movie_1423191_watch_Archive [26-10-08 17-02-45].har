            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <link rel=\"preconnect\" href=\"https://image.tmdb.org\" crossorigin >\n    <link rel=\"preconnect\" href=\"https://api.themoviedb.org\" crossorigin >\n    <link rel=\"dns-prefetch\" href=\"https://image.tmdb.org\" >\n    <link rel=\"dns-prefetch\" href=\"https://api.themoviedb.org\" >\n    <link rel=\"dns-prefetch\" href=\"https://www.googletagmanager.com\" >\n\n    <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;600;700&display=optional\" media=\"print\" onload=\"this.media='all'; document.documentElement.classList.add('fonts-loaded');\" >\n    <noscript><link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;600;700&display=optional\" /></noscript>\n\n    <meta charset=\"UTF-8\" ><link rel=\"preload\" as=\"image\" type=\"image/webp\" href=\"/assets/hero-lcp-mobile.webp\" media=\"(max-width: 768px)\" fetchpriority=\"high\" data-lcp-preload=\"hero-mobile\" ><link rel=\"preload\" as=\"image\" type=\"image/webp\" href=\"/assets/hero-lcp-desktop.webp\" media=\"(min-width: 769px)\" fetchpriority=\"high\" data-lcp-preload=\"hero-desktop\" >\n    <link rel=\"preload\" as=\"style\" href=\"/assets/style-B4wNEF-9.css\" crossorigin onload=\"this.onload=null;this.rel='stylesheet'\" >\n    <noscript><link rel=\"stylesheet\" crossorigin href=\"/assets/style-B4wNEF-9.css\"></noscript>\n    <meta name=\"google-site-verification\" content=\"R06TYeUpJIIPX_s8hq-W_Qzn8-pPMMd0MiXzddlt3M8\" >\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\" >\n    <meta name=\"mobile-web-app-capable\" content=\"yes\" >\n    <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\" >\n\n    <title>Cineby - Watch Free Movies & TV Shows Online</title>\n    <meta name=\"title\" content=\"Cineby - Watch Free Movies & TV Shows Online\">\n    <meta name=\"description\" content=\"Cineby — watch free movies and TV shows online in HD. Browse thousands of films and series on the official Cineby site. No signup required.\">\n    <meta name=\"author\" content=\"Cineby\" >\n    <meta name=\"robots\" content=\"index, follow\" >\n\n    <meta property=\"og:type\" content=\"website\" >\n    <meta property=\"og:url\" content=\"https://cineby.tech/\">\n    <meta property=\"og:title\" content=\"Cineby - Watch Free Movies & TV Shows Online\">\n    <meta property=\"og:description\" content=\"Cineby — watch free movies and TV shows online in HD. Browse thousands of films and series on the official Cineby site. No signup required.\">\n    <meta property=\"og:locale\" content=\"en_US\" >\n    <meta property=\"og:image\" content=\"https://image.tmdb.org/t/p/w780/9Z2uDYXqJrlmePznQQJhL6d92Rq.jpg\">\n    <meta property=\"og:image:width\" content=\"1200\" >\n    <meta property=\"og:image:height\" content=\"630\" >\n    <meta property=\"og:site_name\" content=\"Cineby\" >\n\n    <meta property=\"twitter:card\" content=\"summary_large_image\" >\n    <meta property=\"twitter:url\" content=\"https://cineby.tech/\">\n    <meta property=\"twitter:title\" content=\"Cineby - Watch Free Movies & TV Shows Online\">\n    <meta property=\"twitter:description\" content=\"Cineby — watch free movies and TV shows online in HD. Browse thousands of films and series on the official Cineby site. No signup required.\">\n    <meta property=\"twitter:image\" content=\"https://image.tmdb.org/t/p/w780/9Z2uDYXqJrlmePznQQJhL6d92Rq.jpg\">\n\n    <link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/cineby-logo-32.png\" >\n    <link rel=\"shortcut icon\" type=\"image/png\" href=\"/cineby-logo-32.png\" >\n    <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/cineby-logo-180.png\" >\n    <link rel=\"apple-touch-icon-precomposed\" href=\"/cineby-logo-180.png\" >\n\n    <link rel=\"canonical\" href=\"https://cineby.tech/\">\n\n    <script type=\"application/ld+json\" data-entity-schema=\"true\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@graph\": [\n        {\n          \"@type\": \"Organization\",\n          \"@id\": \"https://cineby.tech/#organization\",\n          \"name\": \"Cineby\",\n          \"alternateName\": \"Cineby.tech\",\n          \"url\": \"https://cineby.tech\",\n          \"logo\": {\n            \"@type\": \"ImageObject\",\n            \"@id\": \"https://cineby.tech/#logo\",\n            \"url\": \"https://cineby.tech/cineby-logo.png\",\n            \"width\": 512,\n            \"height\": 512\n          },\n          \"description\": \"Cineby is a free movie and TV discovery platform at cineby.tech. It helps users find titles, details, ratings, and where to watch. Cineby does not host video files. cineby.tech is the only official Cineby domain.\",\n          \"foundingDate\": \"2024\",\n          \"email\": \"contact@cineby.tech\",\n          \"sameAs\": [\n            \"https://www.reddit.com/r/CinebyOfficial/\",\n            \"https://cineby.tech\"\n          ],\n          \"contactPoint\": {\n            \"@type\": \"ContactPoint\",\n            \"contactType\": \"customer support\",\n            \"email\": \"contact@cineby.tech\",\n            \"url\": \"https://cineby.tech/contact\"\n          }\n        },\n        {\n          \"@type\": \"WebSite\",\n          \"@id\": \"https://cineby.tech/#website\",\n          \"name\": \"Cineby\",\n          \"url\": \"https://cineby.tech\",\n          \"description\": \"Cineby — watch free movies and TV shows online in HD. Browse thousands of films and series on the official Cineby site. No signup required.\",\n          \"publisher\": { \"@id\": \"https://cineby.tech/#organization\" },\n          \"potentialAction\": {\n            \"@type\": \"SearchAction\",\n            \"target\": {\n              \"@type\": \"EntryPoint\",\n              \"urlTemplate\": \"https://cineby.tech/search?q={search_term_string}\"\n            },\n            \"query-input\": \"required name=search_term_string\"\n          }\n        },\n        {\n          \"@type\": \"FAQPage\",\n          \"@id\": \"https://cineby.tech/faq#faq\",\n          \"mainEntity\": [\n            {\n              \"@type\": \"Question\",\n              \"name\": \"What is Cineby?\",\n              \"acceptedAnswer\": {\n                \"@type\": \"Answer\",\n                \"text\": \"Cineby is a free discovery website for movies and TV at cineby.tech. It helps you find titles, details, ratings, and where to watch via third-party embedded players. Cineby does not host video files.\"\n              }\n            },\n            {\n              \"@type\": \"Question\",\n              \"name\": \"Is Cineby free?\",\n              \"acceptedAnswer\": {\n                \"@type\": \"Answer\",\n                \"text\": \"Yes. Browsing and watching through Cineby is free and you do not need a Cineby account. Playback comes from external sources; availability and quality depend on those providers and your region.\"\n              }\n            },\n            {\n              \"@type\": \"Question\",\n              \"name\": \"What is the official Cineby website?\",\n              \"acceptedAnswer\": {\n                \"@type\": \"Answer\",\n                \"text\": \"The only official Cineby domain is cineby.tech. Sites such as cineby.app, cineby.ru, and third-party app-store listings named Cineby are not affiliated with the official Cineby team unless listed at cineby.tech/official.\"\n              }\n            }\n          ]\n        }\n      ]\n    }\n    </script>\n    <script>\n      (function () {\n        if (typeof window === 'undefined') return;\n        var nativeConsoleError = typeof console !== 'undefined' && console.error ? console.error.bind(console) : function () {};\n        function isKnownIframeNoise(message, filename) {\n          var messageText = String(message || '');\n          var sourceText = String(filename || '');\n          var combinedText = messageText + ' ' + sourceText;\n          var hasIframeSecurityPattern = /Blocked a frame with origin|cross-origin frame|Failed to read a named property|SecurityError/i.test(combinedText);\n          var referencesPlayerHost = /vidnest\\.fun/i.test(messageText) || /vidnest\\.fun/i.test(sourceText);\n          return hasIframeSecurityPattern && referencesPlayerHost;\n        }\n        function reportClientIssue(type, payload) {\n          try {\n            if (payload && isKnownIframeNoise(payload.message, payload.filename)) return;\n            if (!payload || (!payload.message && !payload.stack && !payload.filename)) return;\n            nativeConsoleError('[Cineby:' + type + ']', payload || {});\n            var host = location.hostname;\n            var isLocal = host === 'localhost' || host === '127.0.0.1';\n            if (isLocal || !navigator || typeof navigator.sendBeacon !== 'function') return;\n            // No logging endpoint in production — keep console-only reporting.\n            return;\n          } catch (_) {}\n        }\n        window.addEventListener('error', function (event) {\n          var target = event && event.target;\n          if (target && (target.tagName === 'SCRIPT' || target.tagName === 'LINK')) return;\n          var message = event && (event.message || (event.error && event.error.message)) || '';\n          var filename = event && event.filename || '';\n          var stack = event && event.error && event.error.stack || '';\n          reportClientIssue('error', { message: message, filename: filename, stack: stack });\n        }, true);\n        window.addEventListener('unhandledrejection', function (event) {\n          var reason = event && event.reason;\n          var message = reason && reason.message ? reason.message : String(reason || 'Unhandled rejection');\n          reportClientIssue('unhandledrejection', { message: message });\n        });\n      })();\n    </script>\n    <script type=\"module\" crossorigin src=\"/assets/main-BQaVeBWa.js\"></script>\n    \n    \n    \n    \n    \n    \n    \n  </head>\n\n  <body>\n    <div id=\"root\"><main id=\"main-content\" style=\"background:#000;color:#fff;font-family:Raleway,system-ui;min-height:100vh;box-sizing:border-box\">\n  <div style=\"max-width:1280px;margin:0 auto;padding:5rem 1rem 1.5rem\">\n    <h1 style=\"font-size:clamp(1.75rem,5vw,3rem);font-weight:900;margin:0 0 1rem;line-height:1.15\">Cineby - Watch Free Movies &amp; TV Shows Online</h1>\n    <p style=\"color:#d1d5db;font-size:1rem;line-height:1.7;margin:0 0 1rem;max-width:42rem\">Cineby — watch free movies and TV shows online in HD. Browse thousands of films and series on the official Cineby site. No signup required.</p>\n    <h2 style=\"font-size:clamp(1.25rem,3vw,2rem);font-weight:800;margin:1.5rem 0 0.75rem;line-height:1.2;text-transform:uppercase\">The Super Mario Galaxy Movie</h2>\n    <p style=\"color:#e5e7eb;font-size:0.9375rem;line-height:1.65;margin:0 0 1rem;max-width:42rem\">Having thwarted Bowser&#39;s previous plot to marry Princess Peach, Mario and Luigi now face a fresh threat in Bowser Jr., who is determined to liberate his father from captivity and restore the family legacy. Alongside companions new and old, the brothers travel across the stars to stop the young heir&#39;s crusade.</p>\n  </div>\n  <div style=\"width:100%;margin-bottom:1rem\"><picture style=\"display:block;width:100%;max-height:52vh;overflow:hidden\">\n    <source media=\"(min-width:769px)\" type=\"image/webp\" srcset=\"/assets/hero-lcp-desktop.webp\" >\n    <source media=\"(max-width:768px)\" type=\"image/webp\" srcset=\"/assets/hero-lcp-mobile.webp\" >\n    <img src=\"/assets/hero-lcp-mobile.webp\" alt=\"\" fetchpriority=\"high\" loading=\"eager\" decoding=\"async\" width=\"1280\" height=\"720\" style=\"width:100%;aspect-ratio:16/9;max-height:52vh;object-fit:cover;object-position:center top\" >\n  </picture></div>\n  <div style=\"max-width:1280px;margin:0 auto;padding:0 1rem 2.5re