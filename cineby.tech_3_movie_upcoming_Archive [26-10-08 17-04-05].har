            "text": "{\"dates\":{\"maximum\":\"2026-11-04\",\"minimum\":\"2026-10-14\"},\"page\":1,\"results\":[{\"adult\":false,\"backdrop_path\":\"/iRIhPqqoUHiFBxn8oYf3gCQnaKk.jpg\",\"genre_ids\":[28,53],\"id\":1294189,\"title\":\"The Mongoose\",\"original_language\":\"en\",\"original_title\":\"The Mongoose\",\"overview\":\"A falsely accused war hero with nothing to lose leads police on an epic televised cross-country car chase, helped by members of his former Special Forces Army battalion and closely monitored by a fascinated public rooting for his safe getaway.\",\"popularity\":179.0331,\"poster_path\":\"/eSS5mvSG84UUuvtbHel5Yu3Wik4.jpg\",\"release_date\":\"2026-10-30\",\"softcore\":false,\"video\":false,\"vote_average\":0.0,\"vote_count\":0},{\"adult\":false,\"backdrop_path\":\"/5lTZyuBTNOfawsfPT8Q0cIg6qAF.jpg\",\"genre_ids\":[27,53],\"id\":1339713,\"title\":\"Obsession\",\"original_language\":\"en\",\"original_title\":\"Obsession\",\"overview\":\"After breaking the mysterious \\\"One Wish Willow\\\" to win his crush's heart, a hopeless romantic finds himself getting exactly what he asked for but soon discovers that some desires come at a dark, sinister price.\",\"popularity\":152.4461,\"poster_path\":\"/bRwnj8WEKBCvmfeUNOukJPwB43K.jpg\",\"release_date\":\"2026-05-15\",\"softcore\":false,\"video\":false,\"vote_average\":8.183,\"vote_count\":5982},{\"adult\":false,\"backdrop_path\":\"/zDE9hd1SG9695YncbZGjSf7Z9Jk.jpg\",\"genre_ids\":[28,14],\"id\":1153576,\"title\":\"Street Fighter\",\"original_language\":\"en\",\"original_title\":\"Street Fighter\",\"overview\":\"In 1993, estranged Street Fighters Ryu and Ken Masters are thrown back into combat when the mysterious Chun-Li recruits them for the next World Warrior Tournament: a brutal clash of fists, fate, and fury. But behind this battle royale lies a deadly conspiracy that forces them to face off against each other and the demons of their past. And if they don't, it's GAME OVER!\",\"popularity\":29.7666,\"poster_path\":\"/dJPT2Uf12X6aFg8i5N67NTpIZ9t.jpg\",\"release_date\":\"2026-10-16\",\"softcore\":false,\"video\":false,\"vote_average\":0.0,\"vote_count\":0},{\"adult\":false,\"backdrop_path\":\"/1A7s8zG4PF6YoJrncrTO6N4r0Sx.jpg\",\"genre_ids\":[27,53,878],\"id\":1400940,\"title\":\"Clayface\",\"original_language\":\"en\",\"original_title\":\"Clayface\",\"overview\":\"Matt Hagen's meteoric rise from Gotham street kid to Hollywood leading man is tragically cut short when a local crime boss's actions leave him horribly disfigured. Abandoned by his team and with nothing left, Matt seeks out a cutting edge treatment that miraculously returns him to his former self… but also unexpectedly affects his grip on reality, spiraling him down a destructive path of all-consuming revenge.\",\"popularity\":27.5631,\"poster_path\":\"/5jCpQnWPikggmQZoDp1eAi6BI6w.jpg\",\"release_date\":\"2026-10-23\",\"softcore\":false,\"video\":false,\"vote_average\":0.0,\"vote_count\":0},{\"adult\":false,\"backdrop_path\":\"/nuO8o9ltxhI7AZQxePavEZ4TyHa.jpg\",\"genre_ids\":[28,80,18],\"id\":2034,\"title\":\"Training Day\",\"original_language\":\"en\",\"original_title\":\"Training Day\",\"overview\":\"On his first day on the job as a narcotics officer, a rookie cop works with a rogue detective who isn't what he appears.\",\"popularity\":24.3086,\"poster_path\":\"/bUeiwBQdupBLQthMCHKV7zv56uv.jpg\",\"release_date\":\"2001-10-05\",\"softcore\":false,\"video\":false,\"vote_average\":7.532,\"vote_count\":6892},{\"adult\":false,\"backdrop_path\":\"/5oaMV2q0qzxkIW2ukU3lldLu5q2.jpg\",\"genre_ids\":[53,18,80],\"id\":1359,\"title\":\"American Psycho\",\"original_language\":\"en\",\"original_title\":\"American Psycho\",\"overview\":\"A wealthy New York investment banking executive hides his alternate psychopathic ego from his co-workers and friends as he escalates deeper into his illogical, gratuitous fantasies.\",\"popularity\":24.0629,\"poster_path\":\"/9uGHEgsiUXjCNq8wdq4r49YL8A1.jpg\",\"release_date\":\"2000-04-14\"